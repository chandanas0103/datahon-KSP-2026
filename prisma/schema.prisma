generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PoliceStation {
  id          String    @id @default(cuid())
  stationCode String    @unique
  name        String
  area        String
  district    String
  address     String
  phone       String
  officers    Officer[]
  cases       Case[]
}

model Officer {
  id            String        @id @default(cuid())
  badgeNumber   String        @unique
  name          String
  rank          String
  phone         String
  stationId     String
  station       PoliceStation @relation(fields: [stationId], references: [id])
  assignedCases Case[]
}

model CrimeType {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String
  isBailable  Boolean
  description String
  cases       Case[]
}

model Case {
  id           String        @id @default(cuid())
  firNumber    String        @unique
  crimeTypeId  String
  crimeType    CrimeType     @relation(fields: [crimeTypeId], references: [id])
  stationId    String
  station      PoliceStation @relation(fields: [stationId], references: [id])
  status       String
  priority     String
  assignedToId String?
  assignedTo   Officer?      @relation(fields: [assignedToId], references: [id])
  filedDate    DateTime
  incidentDate DateTime
  incidentTime String?
  resolvedDate DateTime?
  description  String
  location     String
  latitude     Float?
  longitude    Float?
  victimName   String?
  victimAge    Int?
  victimGender String?
  suspectName  String?
  suspectAge   Int?
  suspectGender String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model QueryLog {
  id        String   @id @default(cuid())
  question  String
  sqlQuery  String
  sqlResult String?
  answer    String?
  createdAt DateTime @default(now())
}
